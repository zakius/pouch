{
  "manifest_version": 3,
  "name": "Pouch",
  "description": "Save and manage articles with Pouch",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Pouch — save pages to read later",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open the Pouch popup"
    },
    "toggle-save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save or remove the current page"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "alarms",
    "bookmarks",
    "idle"
  ],
  "optional_host_permissions": [
    "*://*/*",
    "https://www.instapaper.com/*",
    "https://api.raindrop.io/*"
  ]
}
