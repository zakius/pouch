{
	"name": "Pouch",
	"version": "1.0.12",
	"description": "Save and manage articles with Pouch",
	"icons": {
		"16": "icons/icon.svg",
		"32": "icons/icon.svg",
		"48": "icons/icon.svg",
		"96": "icons/icon.svg",
		"128": "icons/icon.svg"
	},
	"manifest_version": 2,
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": false
	},
	"browser_action": {
		"default_icon": {
			"48": "icons/icon.svg"
		},
		"default_title": "Pouch",
		"default_popup": "popup/popup.html"
	},
	"background": {
		"page": "background/background.html"
	},
	"page_action": {
		"default_icon": {
			"16": "icons/page-action-unsaved-light.svg",
			"32": "icons/page-action-unsaved-light.svg",
			"48": "icons/page-action-unsaved-light.svg"
		},
		"default_title": "Save to Pouch",
		"show_matches": ["<all_urls>"]
	},
	"permissions": [
		"activeTab",
		"storage",
		"contextMenus",
		"notifications",
		"tabs",
		"alarms",
		"bookmarks",
		"idle",
		"*://*/*"
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "pouch@smartrss",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
