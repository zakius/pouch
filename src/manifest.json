{
  "name": "Pouch",
  "version": "1.0.44",
  "description": "Save and manage articles with Pouch",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "manifest_version": 2,
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon.svg"
    },
    "default_title": "Pouch — save pages to read later",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open the Pouch popup"
    },
    "toggle-save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save or remove the current page"
    }
  },
  "background": {
    "page": "background/background.html"
  },
  "page_action": {
    "default_icon": {
      "48": "icons/icon.svg"
    },
    "default_title": "Save to Pouch",
    "show_matches": ["<all_urls>"]
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "alarms",
    "bookmarks",
    "idle"
  ],
  "optional_permissions": ["*://*/*", "https://www.instapaper.com/*", "https://api.raindrop.io/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "pouch@smartrss",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
