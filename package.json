{
  "name": "pouch-extension",
  "version": "1.0.12",
  "description": "Browser extension for Pouch",
  "type": "module",
  "scripts": {
    "lint": "bunx biome check src",
    "lint:fix": "bunx biome check --write src",
    "type-check": "tsgo --project tsconfig.json",
    "package": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "release": "bun run build.ts",
    "release:sign": "bun run build.ts --sign"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^22.18.1",
    "@typescript/native-preview": "^7.0.0-dev.20250930.1",
    "bun-types": "latest",
    "web-ext": "^8.9.0"
  },
  "dependencies": {
    "valibot": "^0.30.0"
  }
}