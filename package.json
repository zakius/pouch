{
	"name": "pouch-extension",
	"version": "1.0.0",
	"description": "Browser extension for Pouch",
	"type": "module",
	"scripts": {
		"lint": "bunx biome check src",
		"lint:fix": "bunx biome check --write src",
		"type-check": "tsc --project tsconfig.json --noEmit",
		"build:firefox": "bun run build.ts firefox",
		"build:chromium": "bun run build.ts chromium",
		"watch:firefox": "bun run build.ts firefox --watch",
		"watch:chromium": "bun run build.ts chromium --watch",
		"release": "bun run build.ts firefox && bun run build.ts chromium",
		"release:sign": "bun run build.ts firefox --sign && bun run build.ts chromium"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.4",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/firefox-webext-browser": "^120.0.4",
		"@types/node": "^22.17.1",
		"bun-types": "latest",
		"typescript": "^5.9.2",
		"web-ext": "^8.9.0"
	},
	"dependencies": {
		"zod": "^4.0.17"
	}
}
