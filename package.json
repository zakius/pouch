{
  "name": "pouch-extension",
  "version": "1.0.51",
  "description": "Browser extension for Pouch",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --type-check src && bun run diagnostics:effect",
    "lint:fix": "oxlint --fix --type-aware --type-check src && bun run diagnostics:effect",
    "format": "bunx oxfmt src",
    "format:check": "bunx oxfmt --check src",
    "package": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "release": "bun run build.ts",
    "package:chromium": "bun run build.ts --chromium",
    "test": "bun test --isolate",
    "release:sign": "bun run build.ts --sign",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "diagnostics:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --format text",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/node": "25.0.6",
    "bun-types": "1.3.5",
    "crx3": "2.0.0",
    "oxfmt": "0.23.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "web-ext": "9.2.0"
  },
  "dependencies": {
    "effect": "4.0.1",
    "valibot": "^1.2.0"
  }
}