{
  "name": "pouch-extension",
  "version": "1.0.20",
  "description": "Browser extension for Pouch",
  "type": "module",
  "scripts": {
    "lint": "bunx oxlint --type-aware --type-check src",
    "lint:fix": "bunx oxlint --fix --type-aware --type-check src",
    "format": "bunx oxfmt src",
    "format:check": "bunx oxfmt --check src",
    "package": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "release": "bun run build.ts",
    "release:sign": "bun run build.ts --sign"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/node": "25.0.6",
    "@typescript/native-preview": "7.0.0-dev.20260109.1",
    "bun-types": "1.3.5",
    "oxfmt": "0.23.0",
    "oxlint": "1.38.0",
    "oxlint-tsgolint": "0.11.0",
    "web-ext": "9.2.0"
  },
  "dependencies": {
    "valibot": "^1.2.0"
  }
}